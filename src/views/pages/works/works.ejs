<div class="library-page" x-data="{ 
    search: '<%= query.search %>',
    sort: '<%= query.sort %>',
    showGenres: false,
    showTags: false,
    selectedGenresCount: <%= query.genres.length %>,
    selectedTagsCount: <%= query.tags.length %>
}">
    <section class="section">
        <div class="section-header" style="border-bottom: var(--border-hard); padding-bottom: 20px; margin-bottom: 40px;">
            <h2 class="section-title" style="font-size: 32px; letter-spacing: 4px;">БИБЛИОТЕКА</h2>

            <% if (user) { %>
                <a href="/works/new" class="btn">ДОБАВИТЬ ПРОИЗВЕДЕНИЕ</a>
            <% } %>
        </div>

        <form action="/works" method="GET" class="filters-container">
            <input type="hidden" name="page" value="1">
            
            <div class="filter-group main-search">
                <label>ПОИСК ПО НАЗВАНИЮ</label>
                <input type="text" name="search" x-model="search" placeholder="ВВЕДИТЕ ЗАГОЛОВОК...">
            </div>

            <div class="filter-group relative">
                <label>ЖАНРЫ</label>
                <div class="custom-select" @click="showGenres = !showGenres; showTags = false">
                    <span x-text="selectedGenresCount > 0 ? 'ВЫБРАНО: ' + selectedGenresCount : 'ВЫБРАТЬ ЖАНРЫ'"></span>
                    <div class="dropdown" x-show="showGenres" x-cloak @click.away="showGenres = false">
                        <div class="dropdown-list">
                            <% allGenres.forEach(genre => { %>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="genres" value="<%= genre.id %>" 
                                        @change="selectedGenresCount = $root.querySelectorAll('input[name=\'genres\']:checked').length"
                                        <%= query.genres.includes(genre.id) ? 'checked' : '' %>>
                                    <span><%= genre.name.toUpperCase() %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="filter-group relative">
                <label>МЕТКИ</label>
                <div class="custom-select" @click="showTags = !showTags; showGenres = false">
                    <span x-text="selectedTagsCount > 0 ? 'ВЫБРАНО: ' + selectedTagsCount : 'ВЫБРАТЬ МЕТКИ'"></span>
                    <div class="dropdown" x-show="showTags" x-cloak @click.away="showTags = false">
                        <div class="dropdown-list">
                            <% allTags.forEach(tag => { %>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="tags" value="<%= tag.id %>"
                                        @change="selectedTagsCount = $root.querySelectorAll('input[name=\'tags\']:checked').length"
                                        <%= query.tags.includes(tag.id) ? 'checked' : '' %>>
                                    <span><%= tag.name.toUpperCase() %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="filter-group">
                <label>СОРТИРОВКА</label>
                <select name="sort" x-model="sort">
                    <option value="newest">СНАЧАЛА НОВЫЕ</option>
                    <option value="oldest">СНАЧАЛА СТАРЫЕ</option>
                    <option value="popular">ПОПУЛЯРНЫЕ</option>
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-apply">ПРИМЕНИТЬ</button>
                <a href="/works" class="btn btn-reset" title="Сбросить все">✕</a>
            </div>
        </form>

        <div class="works-grid">
            <% if (worksList && worksList.length > 0) { %>
                <% worksList.forEach(work => { %>
                    <%- include('../../partials/cards/work-card', { work: work }) %>
                <% }) %>
            <% } else { %>
                <div class="empty-results">
                    ПО ВАШЕМУ ЗАПРОСУ НИЧЕГО НЕ НАЙДЕНО
                </div>
            <% } %>
        </div>

        <% if (pagination.total > 1) { %>
            <div class="pagination">
                <% 
                    // Функция для сборки URL с сохранением фильтров
                    const getPageUrl = (p) => {
                        const params = new URLSearchParams();
                        if (query.search) params.set('search', query.search);
                        if (query.sort) params.set('sort', query.sort);
                        query.genres.forEach(g => params.append('genres', g));
                        query.tags.forEach(t => params.append('tags', t));
                        params.set('page', p);
                        return '/works?' + params.toString();
                    }
                %>

                <% if (pagination.current > 1) { %>
                    <a href="<%= getPageUrl(pagination.current - 1) %>">←</a>
                <% } %>

                <% for(let i = 1; i <= pagination.total; i++) { %>
                    <a href="<%= getPageUrl(i) %>" class="<%= pagination.current === i ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (pagination.current < pagination.total) { %>
                    <a href="<%= getPageUrl(pagination.current + 1) %>">→</a>
                <% } %>
            </div>
        <% } %>
    </section>
</div>

<style>
/* ... (весь твой предыдущий CSS) ... */

/* Дополнение для пагинации */
.pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
    gap: 10px;
}

.pagination a {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #2a2a33;
    text-decoration: none;
    color: #fff;
    font-size: 14px;
    transition: 0.2s;
}

.pagination a.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
    font-weight: bold;
}

.pagination a:hover:not(.active) {
    border-color: var(--accent);
    color: var(--accent);
}

.filters-container {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr 160px;
    gap: 15px;
    align-items: flex-end;
    margin-bottom: 50px;
    position: relative;
    z-index: 10;
}

.filter-group label {
    display: block;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 2px;
    margin-bottom: 8px;
    text-transform: uppercase;
}

.filter-group input[type="text"], 
.filter-group select, 
.custom-select {
    width: 100%;
    background: #050505;
    border: 1px solid #2a2a33;
    padding: 12px;
    color: #fff;
    font-size: 12px;
    height: 45px;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: border-color 0.2s;
}

.custom-select:hover { border-color: var(--accent); }

.relative { position: relative; }

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    min-width: 220px;
    background: #0b0b0d;
    border: 2px solid #333;
    margin-top: 5px;
    box-shadow: 0 15px 30px rgba(0,0,0,0.9);
    z-index: 100;
}

.dropdown-list {
    max-height: 250px;
    overflow-y: auto;
    padding: 10px;
}

.checkbox-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    cursor: pointer;
    transition: background 0.2s;
}

.checkbox-item:hover { background: rgba(198, 39, 77, 0.1); }

.checkbox-item input {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
}

.checkbox-item span {
    font-size: 11px;
    letter-spacing: 1px;
}

.filter-actions {
    display: flex;
    gap: 5px;
}

.btn-apply {
    flex: 1;
    height: 45px;
    padding: 0 10px;
}

.btn-reset {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    min-width: 45px;
    padding: 0 !important;
    background: transparent;
    border: 2px solid #2a2a33;
    color: var(--text-muted);
    font-size: 18px;
    transition: 0.2s;
}

.btn-reset:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.empty-results {
    grid-column: 1/-1;
    text-align: center;
    padding: 100px;
    border: 1px dashed #333;
    color: var(--text-muted);
    letter-spacing: 2px;
}

.no-cover-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: #050505; color: #222; font-size: 20px;
}

@media (max-width: 1100px) {
    .filters-container { grid-template-columns: 1fr 1fr; }
    .main-search { grid-column: 1 / -1; }
    .filter-actions { grid-column: 1 / -1; }
}
</style>