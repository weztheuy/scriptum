<% 
  const isEdit = typeof chapter !== 'undefined' && chapter.id;
  const actionUrl = isEdit 
    ? `/works/${workId}/chapters/${chapter.id}/edit` 
    : `/works/${workId}/chapters/new`;
  const pageTitle = isEdit ? `РЕДАКТИРОВАНИЕ ГЛАВЫ` : 'ДОБАВЛЕНИЕ ГЛАВЫ';
  const maxPos = maxPosition + (isEdit ? 0 : 1);
%>

<div class="chapter-form-container" x-data="{ 
    tab: 'edit',
    content: `<%- isEdit ? chapter.content.replace(/`/g, '\\`').replace(/\$/g, '\\$') : '' %>`,
    title: '<%= isEdit ? chapter.title.replace(/'/g, "\\'") : '' %>',
    position: <%= isEdit ? chapter.position : maxPos %>,
    get preview() { return typeof marked !== 'undefined' ? marked.parse(this.content) : this.content; }
}">
    <h1 class="page-title"><%= pageTitle %></h1>
    <p class="work-context">К ПРОИЗВЕДЕНИЮ: <span class="accent-link"><%= workTitle.toUpperCase() %></span></p>

    <nav class="form-tabs">
        <button type="button" class="tab-item" :class="{ 'active': tab === 'edit' }" @click="tab = 'edit'">РЕДАКТОР</button>
        <button type="button" class="tab-item" :class="{ 'active': tab === 'preview' }" @click="tab = 'preview'">ПРЕДПРОСМОТР</button>
    </nav>

    <form action="<%= actionUrl %>" method="POST" class="modern-form">
        <div x-show="tab === 'edit'" class="tab-content-pane">
            <div class="form-grid">
                <div class="form-group flex-grow">
                    <label>НАЗВАНИЕ ГЛАВЫ</label>
                    <input type="text" name="title" x-model="title" required placeholder="Глава 1: Начало..." maxlength="100">
                </div>
                <div class="form-group position-input">
                    <label>ПОЗИЦИЯ</label>
                    <div class="position-stepper">
                        <button type="button" @click="if(position > 1) position--" :disabled="position <= 1">—</button>
                        <input type="number" name="position" x-model.number="position" 
                               min="1" max="<%= maxPos %>" readonly required>
                        <button type="button" @click="if(position < <%= maxPos %>) position++" :disabled="position >= <%= maxPos %>">+</button>
                    </div>
                    <span class="max-hint">MAX: <%= maxPos %></span>
                </div>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>ТЕКСТ ГЛАВЫ</label>
                    <span class="md-hint">* ПОДДЕРЖИВАЕТСЯ MARKDOWN</span>
                </div>
                <textarea name="content" x-model="content" rows="22" required 
                          placeholder="Ваша история начинается здесь..."></textarea>
            </div>
        </div>

        <div x-show="tab === 'preview'" class="tab-content-pane preview-scroll" x-cloak>
            <div class="preview-header">
                <h2 class="preview-chapter-title" x-text="title || 'БЕЗ НАЗВАНИЯ'"></h2>
            </div>
            <div class="markdown-body" x-html="preview"></div>
            <template x-if="!content.trim()">
                <div class="empty-state">ПУСТО. НАЧИНАЙТЕ ЖЕ ТВОРИТЬ.</div>
            </template>
        </div>

        <div class="form-footer">
            <div class="footer-actions">
                <button type="submit" class="btn btn-save" :disabled="!title.trim() || !content.trim()">
                    <%= isEdit ? 'ОБНОВИТЬ ГЛАВУ' : 'ОПУБЛИКОВАТЬ' %>
                </button>
                <a href="/works/<%= workId %>" class="btn-cancel">ОТМЕНА</a>
            </div>

            <% if (isEdit) { %>
                <button type="button" 
                        onclick="if(confirm('Удалить главу? Это действие невозможно отменить.')) window.location.href='/works/<%= workId %>/chapters/<%= chapter.id %>/delete'" 
                        class="btn-delete-link">
                    УДАЛИТЬ ГЛАВУ
                </button>
            <% } %>
        </div>
    </form>
</div>

<style>
.chapter-form-container { max-width: 1000px; margin: 40px auto; padding: 0 24px; }
.page-title { font-size: 28px; letter-spacing: 4px; margin-bottom: 10px; color: var(--text-main); }
.work-context { font-size: 11px; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 40px; }
.accent-link { color: var(--accent); }

.form-tabs { display: flex; gap: 0; border-bottom: 1px solid #1a1a1a; margin-bottom: 30px; }
.tab-item { 
    background: none; border: none; border-bottom: 2px solid transparent;
    padding: 12px 24px; color: var(--text-muted); font-size: 11px; 
    letter-spacing: 2px; cursor: pointer; transition: 0.3s;
}
.tab-item:hover { color: var(--accent); }
.tab-item.active { 
    color: var(--accent); border-bottom-color: var(--accent); 
    background: linear-gradient(to top, rgba(198,27,77,0.05), transparent); 
}

.form-grid { display: flex; gap: 30px; margin-bottom: 10px; }
.flex-grow { flex: 1; }
.position-input { width: 150px; }

/* Кастомный степпер позиций */
.position-stepper { 
    display: flex; 
    align-items: center; 
    background: #050505; 
    border: 1px solid #1a1a1a;
    height: 51px;
}
.position-stepper button {
    background: none;
    border: none;
    color: var(--accent);
    width: 48px;
    height: 100%;
    cursor: pointer;
    font-size: 16px;
    transition: 0.2s;
}
.position-stepper button:hover:not(:disabled) {
    background: rgba(198,27,77,0.1);
}
.position-stepper button:disabled {
    color: #333;
    cursor: not-allowed;
}
.position-stepper input {
    flex: 1;
    border: none !important;
    text-align: center;
    padding: 0 !important;
    font-weight: bold;
    pointer-events: none; /* Читатель меняет только кнопками */
}
/* Скрытие стандартных стрелок */
input::-webkit-outer-spin-button,
input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
input[type=number] {
    -moz-appearance: textfield;
}

.max-hint { display: block; margin-top: 8px; font-size: 9px; color: var(--text-muted); letter-spacing: 1px; }

.label-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.md-hint { font-size: 9px; color: var(--accent); letter-spacing: 1px; opacity: 0.9; }

.modern-form label { display: block; font-size: 10px; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 10px; }
.modern-form input, .modern-form textarea { 
    width: 100%; background: #050505; border: 1px solid #1a1a1a; 
    padding: 15px; color: #fff; font-family: inherit; transition: 0.3s; 
}
.modern-form input:focus, .modern-form textarea:focus { border-color: var(--accent); outline: none; }

.tab-content-pane { min-height: 400px; }
.preview-scroll { 
    background: #050505; border: 1px solid #1a1a1a; padding: 40px; 
    color: #ccc; line-height: 1.8; max-height: 700px; overflow-y: auto;
}
.preview-chapter-title { 
    font-size: 22px; letter-spacing: 2px; text-align: center; 
    margin-bottom: 40px; color: #fff; padding-bottom: 20px; border-bottom: 1px solid #1a1a1a; 
}
.empty-state { text-align: center; padding: 100px 0; color: #333; font-size: 12px; letter-spacing: 2px; }

.form-footer { 
    margin-top: 40px; padding-top: 30px; border-top: 1px solid #1a1a1a; 
    display: flex; justify-content: space-between; align-items: center; 
}
.footer-actions { display: flex; align-items: center; gap: 24px; }
.btn-cancel { font-size: 11px; letter-spacing: 2px; color: var(--text-muted); }
.btn-cancel:hover { color: var(--text-main); text-decoration: underline; }

.btn-save:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    filter: grayscale(1);
    box-shadow: none;
    transform: none !important;
}

.btn-delete-link {
    background: none; border: none; color: #444; font-size: 10px;
    letter-spacing: 1px; cursor: pointer; transition: 0.3s;
    text-decoration: underline;
}
.btn-delete-link:hover { color: var(--accent); }

[x-cloak] { display: none !important; }

.markdown-body { font-size: 15px; }
.markdown-body p { margin-bottom: 1.2em; }
.markdown-body h1, .markdown-body h2, .markdown-body h3 { color: #fff; margin-top: 1.5em; }
</style>