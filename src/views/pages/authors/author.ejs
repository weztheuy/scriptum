<div class="profile-page" x-data="{ tab: '<%= activeTab %>' }">
    <header class="profile-header">
        <div class="profile-avatar">
            <% if (profile.avatarUrl) { %>
                <img src="<%= profile.avatarUrl %>" alt="<%= profile.publicName %>">
            <% } else { %>
                <div class="avatar-placeholder">
                    <%= profile.publicName.charAt(0).toUpperCase() %>
                </div>
            <% } %>
        </div>
        
        <div class="profile-info">
            <h1 class="profile-name"><%= profile.publicName %></h1>
            <p class="profile-login">@<%= profile.login %></p>
            <p class="profile-bio"><%= profile.bio %></p>
            
            <% if (isOwner) { %>
                <div class="profile-actions">
                    <a href="/settings/profile" class="btn btn-outline">РЕДАКТИРОВАТЬ ПРОФИЛЬ</a>
                </div>
            <% } %>
        </div>
    </header>

    <nav class="profile-tabs">
        <button :class="{ 'active': tab === 'works' }" @click="tab = 'works'; history.replaceState(null, '', '?tab=works')">
            ПРОИЗВЕДЕНИЯ (<%= authorWorks.count %>)
        </button>

        <% ['reading', 'completed', 'bookmarks'].forEach(type => { 
            const shelf = shelvesData[type];
            const label = type === 'reading' ? 'ЧИТАЮ' : type === 'completed' ? 'ПРОЧИТАНО' : 'ЗАКЛАДКИ';
            // Для гостя скрываем реальное число, если полка приватная
            const displayCount = (shelf && !shelf.isPublic && !isOwner) ? '?' : (shelf ? shelf.count : 0);
        %>
            <button :class="{ 'active': tab === '<%= type %>' }" @click="tab = '<%= type %>'; history.replaceState(null, '', '?tab=<%= type %>')">
                <%= label %> (<%= displayCount %>)
            </button>
        <% }) %>
    </nav>

    <div class="tab-content">
        <div x-show="tab === 'works'">
            <div class="works-grid">
                <% if (authorWorks.items.length > 0) { %>
                    <% authorWorks.items.forEach(work => { %>
                        <%- include('../../partials/cards/work-card', { work: work }) %>
                    <% }) %>
                <% } else { %>
                    <div class="empty-msg">АВТОР ЕЩЕ НЕ ОПУБЛИКОВАЛ НИ ОДНОЙ РАБОТЫ</div>
                <% } %>
            </div>
            <% if (authorWorks.total > 1) { %>
                <%- include('../../partials/ui/pagination-profile', { total: authorWorks.total, current: currentPage, tab: 'works' }) %>
            <% } %>
        </div>

        <% ['reading', 'completed', 'bookmarks'].forEach(type => { 
            const shelf = shelvesData[type];
            // Плашка показывается ТОЛЬКО если (полка приватная) И (посетитель НЕ владелец)
            const showPrivacyLock = shelf && !shelf.isPublic && !isOwner;
        %>
            <div x-show="tab === '<%= type %>'">
                <% if (showPrivacyLock) { %>
                    <div class="privacy-lock-box">
                        <h2 class="lock-title">РАЗДЕЛ СКРЫТ</h2>
                        <p class="lock-text">Пользователь ограничил доступ к этому списку в настройках приватности.</p>
                    </div>
                <% } else { %>
                    <div class="works-grid">
                        <% if (shelf && shelf.items.length > 0) { %>
                            <% shelf.items.forEach(work => { %>
                                <%- include('../../partials/cards/work-card', { work: work }) %>
                            <% }) %>
                        <% } else { %>
                            <div class="empty-msg">СПИСОК ПУСТ</div>
                        <% } %>
                    </div>
                    <% if (shelf && shelf.total > 1) { %>
                        <%- include('../../partials/ui/pagination-profile', { total: shelf.total, current: currentPage, tab: type }) %>
                    <% } %>
                <% } %>
            </div>
        <% }) %>
    </div>
</div>

<style>
    
.privacy-lock-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px 20px;
    border: 1px solid #1a1a1a;
    background: rgba(10, 10, 10, 0.5);
    text-align: center;
    border-radius: 4px;
}

.lock-title {
    font-size: 16px;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 10px;
}

.lock-text {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 1px;
    max-width: 400px;
    line-height: 1.6;
}
    
.profile-header {
    display: flex;
    gap: 40px;
    padding: 60px 0;
    border-bottom: 2px solid #1a1a1a;
    margin-bottom: 40px;
}

.profile-avatar {
    width: 150px;
    height: 150px;
    flex-shrink: 0;
    border: 3px solid #1a1a1a;
    background: #000;
    overflow: hidden;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a0a0a;
    color: var(--accent);
    font-size: 64px;
    font-weight: bold;
}

.profile-info { flex: 1; }

.profile-name {
    font-size: 20px;
    letter-spacing: 4px;
    margin-bottom: 10px;
    line-height: 1;
}

.profile-login {
    font-family: monospace;
    color: var(--text-muted);
    font-size: 16px;
    margin-bottom: 20px;
}

.profile-bio {
    max-width: 700px;
    line-height: 1.6;
    color: #ccc;
    font-size: 14px;
}

.profile-actions { margin-top: 25px; }

.profile-tabs {
    display: flex;
    gap: 30px;
    border-bottom: 1px solid #222;
    margin-bottom: 40px;
}

.profile-tabs button {
    background: none;
    border: none;
    color: var(--text-muted);
    padding: 20px 0;
    cursor: pointer;
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: bold;
    border-bottom: 3px solid transparent;
    transition: 0.2s;
    text-transform: uppercase;
}

.profile-tabs button:hover { color: #fff; }

.profile-tabs button.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.empty-msg {
    grid-column: 1/-1;
    padding: 80px;
    text-align: center;
    color: #333;
    border: 1px dashed #222;
    letter-spacing: 2px;
    font-size: 14px;
}

.tab-content {
    padding-bottom: 40px;
    min-height: 418px;
}

@media (max-width: 768px) {
    .profile-header { flex-direction: column; text-align: center; align-items: center; }
    .profile-tabs { overflow-x: auto; white-space: nowrap; gap: 20px; }
}
</style>