<div class="author-card">
    <div class="author-avatar">
        <%= author.publicName ? author.publicName.charAt(0).toUpperCase() : '?' %>
    </div>
    <div class="author-info">
        <h3 class="author-name">
            <a href="/authors/<%= author.id %>"><%= author.publicName %></a>
        </h3>
        <p class="author-login">@<%= author.login %></p>
        <span class="author-stats">КНИГ: <%= author.worksCount %></span>
    </div>
</div>

<style>
.author-avatar {
    width: 60px;
    height: 60px;
    background: #1a1a20;
    border: 2px solid #333;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    color: var(--accent);
}

.author-name a {
    text-decoration: none;
    color: inherit;
}

.author-name a:hover {
    color: var(--accent);
    text-decoration: underline;
}
</style>