<article class="card work-card <%= (work.isPublic === false || work.isPublic === 0) ? 'draft-card' : '' %>">
    <div class="cover">
        <% if (work.isPublic === false || work.isPublic === 0) { %>
            <div class="draft-badge">ЧЕРНОВИК</div>
        <% } %>
        <% if (work.coverUrl) { %>
            <img src="<%= work.coverUrl %>" alt="<%= work.title %>">
        <% } else { %>
            <div class="no-cover-placeholder">NO COVER</div>
        <% } %>
    </div>
    <div class="card-body">
        <a href="/works/<%= work.id %>" class="work-title" onclick="event.stopPropagation()"><%= work.title %></a>
        <a href="/authors/<%= work.authorId %>" class="work-author" onclick="event.stopPropagation()"><%= work.authorName %></a>
        <p class="work-desc"><%= work.description ? work.description.substring(0, 100) + '...' : '' %></p>
    </div>
</article>

<style>
/* Общий стиль для пустых обложек */
.no-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #050505;
    color: #222; /* Темно-серый текст на черном фоне в стиле брутализма */
    font-size: 20px;
    letter-spacing: 2px;
    border: 1px solid #1a1a1a;
}

/* Стили для самой карточки на главной, если они еще не заданы */
.work-card {
    transition: transform 0.2s, border-color 0.2s;
    position: relative;
}

.work-card:hover {
    border-color: var(--accent);
}

.work-card .cover {
    aspect-ratio: 2/3;
    overflow: hidden;
    background: #111;
    position: relative;
}

.work-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Стили для черновиков */
.draft-card { opacity: 0.8; border-style: dashed; }
.draft-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #000;
    color: var(--accent);
    padding: 4px 8px;
    font-size: 9px;
    font-weight: bold;
    z-index: 5;
    border: 1px solid var(--accent);
    letter-spacing: 1px;
}
</style>